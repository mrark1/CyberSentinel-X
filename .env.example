# Google Gemini API Key (server-side only, used for live AI incident analysis)
# If omitted or exhausted, CyberSentinel X automatically uses the deterministic DEMO ANALYSIS fallback.
# Never commit real secrets.
GEMINI_API_KEY=

# Server Port (optional, defaults to 3000 in local dev; injected by cloud hosts such as Cloud Run)
PORT=

# Hosted Application URL (optional)
APP_URL=
